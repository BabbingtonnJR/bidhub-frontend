# Usado no build da Shell (e dos MFs, quando rodam sozinhos)
# URL do API Gateway (APIM) com o sufixo da API; localmente pode apontar direto para o BFF
VITE_API_URL=https://<apim>.azure-api.net/api
# chave de assinatura do APIM (Ocp-Apim-Subscription-Key); vazio quando chama o BFF direto
VITE_API_KEY=
# onde estão publicados os remoteEntry.js dos microfrontends (build da Shell)
VITE_MF_LEILOES_URL=https://<swa-mf-leiloes>.azurestaticapps.net/assets/remoteEntry.js
VITE_MF_FINANCEIRO_URL=https://<swa-mf-financeiro>.azurestaticapps.net/assets/remoteEntry.js
